{
  // itin-wizard (Vite + React SPA) on Cloudflare Workers static assets.
  // Vercel → Cloudflare migration Phase 3 (vechelon repo: docs/hosting-migration/MIGRATION_LOG.md).
  // Deploy: npm run deploy:cloudflare  (builds, drops public/_redirects — its catch-all loops on Cloudflare and
  // not_found_handling below already does the SPA fallback — then wrangler deploy). VITE_SUPABASE_* baked in at build time.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "itin-wizard",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  // Production hostname (Phase 4 cutover 2026-09-23).
  "routes": [
    { "pattern": "itin-wizard.productdelivered.ca", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    // vercel.json: /(.*) → /index.html — every unknown path serves the SPA shell
    "not_found_handling": "single-page-application"
  }
}
